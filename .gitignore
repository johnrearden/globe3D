node_modules/
# Local test tileset (1.5GB) — deployed via rsync, not committed
assets/planet-z9.pmtiles
assets/*.pmtiles
# Cloudflare Pages staging output (regenerated by build:pages)
dist/
# ...but the design-token artefacts ARE committed: they exist so a knob change
# shows up as a reviewable diff across all three platforms, and an ignored
# generated file is a drift nobody sees. `npm test` fails if they go stale.
!packages/design-tokens/dist/
# Generated border-quiz landing pages (regenerated by build-landing.mjs from
# the committed landing/borders-data.json + template + img/borders/*.png).
# Leading slash anchors this to the repo root so it does NOT also ignore the
# committed source images under img/borders/.
/borders/
# Raw image-editing sources (e.g. GIMP .xcf) for the landing-page hero captures.
img/sources/
.venv/
venv/

# Pre-compressed asset upload staging (npm run build:assets)
dist-assets/

# Astro build output + generated types (apps/web).
apps/web/dist/
apps/web/.astro/

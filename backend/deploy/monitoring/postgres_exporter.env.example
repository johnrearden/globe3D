# Copy to /etc/postgres_exporter/postgres_exporter.env (mode 0600) and set the
# password to match create-monitoring-role.sql. The exporter connects to the local
# Postgres as the least-priv monitoring role. sslmode=disable is fine for a
# loopback connection (Postgres binds 127.0.0.1 per deploy/README.md).
DATA_SOURCE_NAME=postgresql://globe3d_monitor:CHANGE_ME@127.0.0.1:5432/globe3d?sslmode=disable

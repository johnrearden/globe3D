# systemd unit for the Globe3D API (gunicorn).
# Install: sudo cp backend/deploy/globe3d.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now globe3d
#
# Assumes the layout from deploy/README.md:
#   repo at /srv/globe3d/app, venv at /srv/globe3d/app/.venv,
#   run as the `globe3d` system user. Configuration (DATABASE_URL, REDIS_URL,
#   secret key, hosts, …) is read from /srv/globe3d/app/backend/.env, which the
#   app auto-loads via python-dotenv — no systemd EnvironmentFile needed.

[Unit]
Description=Globe3D API (gunicorn)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=notify
User=globe3d
Group=globe3d
# gunicorn binds a socket in /run; RuntimeDirectory creates /run/globe3d first
# (not strictly needed when binding /run/globe3d.sock directly, but harmless and
# ready if you move the socket under a subdir).
RuntimeDirectory=globe3d
WorkingDirectory=/srv/globe3d/app/backend
ExecStart=/srv/globe3d/app/.venv/bin/gunicorn config.wsgi -c deploy/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

# The socket is created globe3d:globe3d mode 0660 (see gunicorn umask). nginx
# reaches it because www-data is added to the globe3d group in README step 8
# (sudo usermod -aG globe3d www-data).

# Hardening.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target

# systemd unit for the Globe3D API (gunicorn).
# Install: sudo cp backend/deploy/globe3d.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now globe3d
#
# Current layout (see deploy/README.md):
#   repo at /srv/globe3d (backend at /srv/globe3d/backend),
#   venv at /srv/globe3d/backend/.venv, run as the `john` user.
#   Configuration (DATABASE_URL, REDIS_URL, secret key, hosts, …) is read from
#   /srv/globe3d/backend/.env, which the app auto-loads via python-dotenv — no
#   systemd EnvironmentFile needed.

[Unit]
Description=Globe3D API (gunicorn)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=notify
User=john
Group=john
# gunicorn binds its socket inside /run/globe3d; RuntimeDirectory creates that
# directory (owned john:john, cleaned up on stop). /run itself is root-owned and
# not writable by `john`, so the socket must live under this subdir — see
# GUNICORN_BIND in deploy/gunicorn.conf.py (unix:/run/globe3d/globe3d.sock).
RuntimeDirectory=globe3d
WorkingDirectory=/srv/globe3d/backend
# prometheus_client multiprocess collector dir (workers each write metric .db
# files here; /metrics aggregates across them). Lives under the tmpfs /run/globe3d
# that RuntimeDirectory creates; the prometheus/ subdir is made by gunicorn's
# on_starting hook. Authoritative here (mirrors gunicorn.conf.py's setdefault).
Environment=PROMETHEUS_MULTIPROC_DIR=/run/globe3d/prometheus
ExecStart=/srv/globe3d/backend/.venv/bin/gunicorn config.wsgi -c deploy/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

# The socket is created john:john mode 0660 (see gunicorn umask 0o007). nginx
# reaches it because www-data is added to the `john` group in README step 8
# (sudo usermod -aG john www-data).

# Hardening.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target

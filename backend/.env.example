# Copy to backend/.env and adjust. settings.py auto-loads backend/.env at startup
# via python-dotenv, so these become available as os.environ. .env is gitignored;
# place the real file in backend/ on both dev and the server. Real environment
# variables (e.g. set by systemd/the shell) still override values from this file.

# --- Core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database / cache (production) ---
# Leave both unset for local dev: settings.py falls back to the SQLite file and
# an in-process (locmem) cache, so nothing extra is needed to run the dev server.
# In production set these to engage Postgres + Redis (see backend/deploy/README.md):
# DATABASE_URL=postgres://globe3d:CHANGE_ME@127.0.0.1:5432/globe3d
# REDIS_URL=redis://127.0.0.1:6379/0
# DB_CONN_MAX_AGE=60

# --- CORS / CSRF ---
# The origin(s) the static frontend is served from (Cloudflare in production).
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=

# --- Superuser audit launch (/audit/launch → frontend hand-off) ---
# Where /audit/launch sends the signed token. In dev this defaults to
# http://localhost:8001; in production, if left unset, it falls back to the first
# CORS_ALLOWED_ORIGINS entry — set it explicitly to be safe. AUDIT_TOKEN_MAX_AGE
# is the token lifetime in seconds (default 3600 = 1h).
# AUDIT_FRONTEND_ORIGIN=http://localhost:8001
# AUDIT_TOKEN_MAX_AGE=3600

# --- Production example (DEBUG off; API at api.terragotcha.com behind Cloudflare) ---
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=api.terragotcha.com
# CORS_ALLOWED_ORIGINS=https://terragotcha.com,https://www.terragotcha.com
# CSRF_TRUSTED_ORIGINS=https://api.terragotcha.com
# AUDIT_FRONTEND_ORIGIN=https://terragotcha.com
# AUDIT_TOKEN_MAX_AGE=3600

# --- Daily quiz tuning ---
DAILY_QUIZ_QUESTION_COUNT=10
ANSWER_MIN_MS=250
ANSWER_MAX_MS=120000
ANSWER_WALLCLOCK_MIN_RATIO=0.5

# --- Monitoring (production; see backend/deploy/monitoring/README.md) ---
# Error tracking via GlitchTip (Sentry-compatible). Leave GLITCHTIP_DSN unset in
# dev/tests so the app never phones home; set it on the server to the backend
# project's DSN. The frontend uses a SEPARATE (browser) project DSN, set in
# js/data/site-config.js — not here.
# GLITCHTIP_DSN=https://<publicKey>@glitchtip.example.com/<projectId>
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=                 # optional, e.g. the git SHA, set at deploy time
# SENTRY_TRACES_SAMPLE_RATE=0.0   # GlitchTip perf support is basic; keep low/0
# DJANGO_LOG_LEVEL=INFO           # root/django log level -> journald

# --- Stripe (later milestone; unused in v1) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Copy to .env and adjust. These map to settings.py via os.environ.
# (settings.py reads os.environ directly; load this file with your process
#  manager, direnv, or `export $(grep -v '^#' .env | xargs)`.)

# --- Core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS / CSRF ---
# The origin(s) the static frontend is served from (Cloudflare in production).
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=

# --- Daily quiz tuning ---
DAILY_QUIZ_QUESTION_COUNT=10
ANSWER_MIN_MS=250
ANSWER_MAX_MS=120000
ANSWER_WALLCLOCK_MIN_RATIO=0.5

# --- Stripe (later milestone; unused in v1) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

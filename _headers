# Cloudflare Pages headers. Compression (gzip/br) is applied automatically by
# the platform — do not set Content-Encoding here.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()

# The baked binary assets are large and effectively immutable.
/*.bin
  Cache-Control: public, max-age=31536000, immutable

# HTML is the entry point — always revalidate so deploys are picked up.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Stylesheet + JS module tree change every deploy — revalidate (etag → 304 when
# unchanged) so a stale cache never serves old CSS/JS against fresh index.html.
/styles.css
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Astro's bundles are content-hashed, so a change is a new URL — safe to cache
# forever. Without this rule they fall through to /* and get no Cache-Control at
# all, i.e. re-fetched every visit.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Country pages are the opposite: stable URLs whose content gets edited, so they
# must revalidate like index.html. Covers the .json siblings the router fetches.
/country/*
  Cache-Control: public, max-age=0, must-revalidate
